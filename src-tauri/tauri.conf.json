{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Inkwell",
  "version": "1.0.0",
  "identifier": "io.inkwell.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Inkwell",
        "width": 1200,
        "height": 800,
        "minWidth": 680,
        "minHeight": 480,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: ink-image: http://ink-image.localhost; font-src 'self' data:; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: ink-image: http://ink-image.localhost; font-src 'self' data:; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Inkwell",
    "homepage": "https://github.com/kainpl/inkwell",
    "category": "Productivity",
    "license": "MIT",
    "shortDescription": "Markdown editor with live preview",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "licenses/Inkwell.txt",
      "../THIRD-PARTY.md": "licenses/THIRD-PARTY.md",
      "../node_modules/@fontsource-variable/jetbrains-mono/LICENSE": "licenses/JetBrains-Mono.txt",
      "../node_modules/dictionary-en/index.aff": "dictionaries/dictionary-en/index.aff",
      "../node_modules/dictionary-en/index.dic": "dictionaries/dictionary-en/index.dic",
      "../node_modules/dictionary-en/license": "dictionaries/dictionary-en/license",
      "../node_modules/dictionary-uk/index.aff": "dictionaries/dictionary-uk/index.aff",
      "../node_modules/dictionary-uk/index.dic": "dictionaries/dictionary-uk/index.dic",
      "../node_modules/dictionary-uk/license": "dictionaries/dictionary-uk/license"
    }
  }
}
