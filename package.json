{
  "name": "inkwell",
  "version": "1.0.0",
  "description": "A desktop Markdown editor with seamless live preview, built with Tauri and React.",
  "type": "module",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "start": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "vite build",
    "tauri": "tauri",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:win": "tauri build --bundles nsis",
    "build:mac": "tauri build --bundles dmg",
    "build:linux": "tauri build --bundles appimage"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.2",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/common": "^1.5.6",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.8.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "codemirror": "^6.0.1",
    "dictionary-en": "^4.0.0",
    "dictionary-uk": "^4.0.0",
    "dompurify": "^3.5.0",
    "katex": "^0.17.0",
    "lucide": "^1.77.0",
    "markdown-it": "^14.3.3",
    "mermaid": "^11.17.2",
    "node-emoji": "^2.2.0",
    "tauri-plugin-snap-layout": "^1.0.9",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/react": "^16.3.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
